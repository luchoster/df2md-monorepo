# Sanity — studio project rthdhol7 (created manually; tokens: manage.sanity.io → project → API → Tokens)
SANITY_PROJECT_ID=rthdhol7
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Snipcart (add your secret API key)
SNIPCART_API_AUTH=

# Stripe (test secret for catalog sync; restricted read-only LIVE key for the customer audit)
STRIPE_SECRET_KEY=
# Publishable key for the on-page Payment Element (same Stripe account/mode as the secret key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_READ_KEY=
# Signing secret of the Stripe webhook → https://<site>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid)
STRIPE_WEBHOOK_SECRET=

# Supabase customer accounts (Project Settings → API Keys). Accounts stay switched off until the
# URL and publishable key are set; the secret key lets the Stripe webhook save orders.
# Setup: docs/ACCOUNTS.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# shadcnblocks Pro registry (npx shadcn add @shadcnblocks/<block>); set as an environment variable
SHADCNBLOCKS_API_KEY=
